{
  "compilerOptions": {
    "target": "es2022",
    "module": "node20",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@features/*": ["./src/features/*"],
      "@app-types/*": ["./src/types/*"]
    }
  },
  "include": ["electron/**/*.js"]
}
